MYSQL_DATABASE=jigsaw
MYSQL_USER=jigsaw
MYSQL_PASSWORD=local_dev_only
MYSQL_ROOT_PASSWORD=local_root_dev_only
VITE_API_BASE_URL=/api
IMPORT_STORAGE_QUOTA_BYTES=1073741824
SESSION_COOKIE_SECURE=0
# Optional processor: Compose defaults to its private service; empty selects PHP/GD.
# IMAGE_PROCESSOR_URL=
# Development only. Use a private, matching secret for any separately hosted processor.
PROCESSOR_KEY=local-image-processing-only

# Optional AI recognition. Use a Gemini project on the free tier.
GEMINI_API_KEY=
GEMINI_RECOGNITION_MODEL=gemini-3.1-flash-lite
AI_RECOGNITION_DAILY_LIMIT=20
AI_RECOGNITION_USER_DAILY_LIMIT=5
